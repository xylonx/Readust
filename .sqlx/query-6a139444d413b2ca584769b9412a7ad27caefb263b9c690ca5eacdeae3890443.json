{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            user_id,\n            kind AS \"kind: ReplicaKind\",\n            replica_id,\n            fields_jsonb,\n            manifest_jsonb,\n            deleted_at_ts,\n            reincarnation,\n            updated_at_ts,\n            schema_version,\n            created_at,\n            modified_at\n        FROM replicas\n        WHERE user_id = $1 AND kind = $2 AND ($3::text IS NULL OR updated_at_ts > $3)\n        ORDER BY updated_at_ts\n        LIMIT 1000\n        ",
